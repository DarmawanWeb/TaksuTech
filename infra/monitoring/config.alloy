// Ships logs from this compose project's containers to Loki, labelled by service.
discovery.docker "taksu" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=taksu"]
  }
}

discovery.relabel "taksu" {
  targets = discovery.docker.taksu.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "taksu" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.taksu.targets
  relabel_rules = discovery.relabel.taksu.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
