# TLS ends at Cloudflare; cloudflared on the Mac talks plain HTTP to this Caddy on 127.0.0.1.
{
	auto_https off
	admin localhost:2019
	metrics {
		per_host
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

(common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	log {
		output stdout
		format json
	}
}

http://{$WEB_HOST} {
	import common
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	reverse_proxy web:3000
}

http://{$EDU_HOST} {
	import common
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	# Lab submissions carry up to four photos of 8 MB each.
	request_body {
		max_size 40MB
	}
	reverse_proxy edu:3000
}

http://{$ROBOT_HOST} {
	import common
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	reverse_proxy robot:3000
}

http://{$KIOSK_HOST} {
	import common
	# Visitors talk to the robot, so the kiosk may ask for the microphone.
	header Permissions-Policy "camera=(), microphone=(self), geolocation=()"
	request_body {
		max_size 5MB
	}
	reverse_proxy kiosk:3000
}

http://{$SIM_HOST} {
	import common
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	reverse_proxy sim:3000
}

# Gate this hostname with Cloudflare Access as well as Grafana's own login.
http://{$GRAFANA_HOST} {
	import common
	reverse_proxy grafana:3000
}

# Prometheus scrapes Caddy here, inside the Docker network only.
:2020 {
	metrics /metrics
}

:80 {
	respond "Not found" 404
}
