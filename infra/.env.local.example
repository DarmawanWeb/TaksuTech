# Run the whole stack on your own machine, next to other local stacks, with no tunnel:
#   cp infra/.env.local.example infra/.env && infra/deploy.sh
# Then open http://taksu.localhost:4480. Chrome and Firefox send every *.localhost name to
# 127.0.0.1 by themselves; for Safari or other tools, add this line to /etc/hosts:
#   127.0.0.1 taksu.localhost robot.taksu.localhost kiosk.taksu.localhost edu.taksu.localhost sim.taksu.localhost grafana.taksu.localhost
WEB_HOST=taksu.localhost
ROBOT_HOST=robot.taksu.localhost
KIOSK_HOST=kiosk.taksu.localhost
EDU_HOST=edu.taksu.localhost
SIM_HOST=sim.taksu.localhost
GRAFANA_HOST=grafana.taksu.localhost

# The links between the sites: plain HTTP through Caddy's port. A *.localhost page counts as a
# secure context, so the kiosk can still use the microphone.
PUBLIC_SCHEME=http
PUBLIC_PORT_SUFFIX=:4480

# Caddy is the only published port, on 127.0.0.1. Taken elsewhere on this machine, so avoid:
# 80 (Netra), 8080 and 8081 (Pasupasastra), 8088 (Netra's tunnel), 3000 (Next.js dev servers).
CADDY_PORT=4480
# 1 = also run Prometheus, Loki, Alloy, blackbox, and Grafana. Off by default to save memory.
MONITORING=0

WHATSAPP_NUMBER=
CONTACT_EMAIL=
TOKOPEDIA_URL=
SHOPEE_URL=

# Native Ollama on macOS. If another stack runs its own Ollama container on 11434, point this at
# whichever one has the taksu-asisten model (infra/ollama/setup.sh).
AI_PROVIDER=ollama
AI_MODEL=taksu-asisten
AI_BASE_URL=http://host.docker.internal:11434
AI_TIMEOUT_MS=20000
AI_KEEP_ALIVE=30m
AI_MAX_CONCURRENCY=2
ASSISTANT_RATE_LIMIT=12

# base keeps the speech service light on a laptop; small is the Mac mini default.
WHISPER_MODEL=base
WHISPER_COMPUTE=int8
WHISPER_CPU_THREADS=4
PIPER_VOICE_ID=id_ID-news_tts-medium
PIPER_VOICE_EN=en_US-lessac-medium

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
