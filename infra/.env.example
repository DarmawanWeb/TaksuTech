# Copy to infra/.env (or ~/web/ulik.env) on the Mac mini. Never commit the real file.
WEB_HOST=ulik.agus-darmawan.com
SIM_HOST=ulik-sim.agus-darmawan.com

# Loopback port for Caddy. Not 80 (taken), 8080 (cAdvisor), or 4480 (Taksu's Caddy).
CADDY_PORT=4490
# Name or UUID of the existing tunnel, for infra/scripts/cloudflare-ingress.sh.
CLOUDFLARE_TUNNEL=

# Orders, quotes, and questions open as WhatsApp messages to this number.
# Digits only, with the country code: 628123456789. Empty means email only.
WHATSAPP_NUMBER=
# Where email orders go. Empty uses the address in packages/catalog/src/brand.ts.
CONTACT_EMAIL=
# Our store pages on each marketplace. A button only appears once its link is set.
TOKOPEDIA_URL=
SHOPEE_URL=
