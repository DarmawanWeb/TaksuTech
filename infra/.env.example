# Copy to infra/.env on the Mac mini. Never commit the real file.
WEB_HOST=taksu.agus-darmawan.com
EDU_HOST=taksu-edu.agus-darmawan.com
ROBOT_HOST=taksu-robot.agus-darmawan.com
KIOSK_HOST=taksu-kiosk.agus-darmawan.com
SIM_HOST=taksu-sim.agus-darmawan.com
GRAFANA_HOST=taksu-grafana.agus-darmawan.com

# Loopback port for Caddy. Not 80 (already taken) and not 8080 (cAdvisor).
CADDY_PORT=4480
# 1 = also run Prometheus, Loki, Alloy, blackbox, and Grafana for this stack.
MONITORING=1
# Name or UUID of the existing tunnel, for infra/scripts/cloudflare-ingress.sh.
CLOUDFLARE_TUNNEL=

WHATSAPP_NUMBER=

# Lab on the edu site (class builds and forum). Posts wait for review at /id/lab/admin.
# Without a password the review page stays locked and nothing gets published.
LAB_ADMIN_PASSWORD=
# Signs the review session cookie. Generate one: openssl rand -hex 32
LAB_SECRET=
# Optional: gets a short message for every new post, e.g. https://ntfy.sh/<your-topic>
LAB_NOTIFY_URL=

AI_PROVIDER=ollama
AI_MODEL=taksu-asisten
AI_BASE_URL=http://host.docker.internal:11434
AI_TIMEOUT_MS=20000
AI_KEEP_ALIVE=30m
AI_MAX_CONCURRENCY=2
ASSISTANT_RATE_LIMIT=12

# Speech: small is a good balance on the M4 CPU inside Docker; base is faster, medium more accurate.
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_CPU_THREADS=4
PIPER_VOICE_ID=id_ID-news_tts-medium
PIPER_VOICE_EN=en_US-lessac-medium

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
