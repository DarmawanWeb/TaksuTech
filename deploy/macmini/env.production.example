# Taksu Tech production env for the Mac mini.
# Location: ~/apps/taksu-tech/shared/.env.production (outside git, never commit it).

# Public hostnames served through Cloudflare Tunnel. Keep them one level under your domain
# (taksu.example.com, not kiosk.taksu.example.com): Universal SSL only covers *.example.com.
WEB_HOSTNAME=taksu.example.com
KIOSK_HOSTNAME=taksu-kiosk.example.com
PLAYGROUND_HOSTNAME=taksu-belajar.example.com

# Local ports, bound to 127.0.0.1 only. Port 80 is refused by the scripts.
# Avoid 3000 (Grafana), 3100 (Loki), 9090, 9100, 8080, 5432 already used by the monitoring/DB stack.
WEB_PORT=4300
KIOSK_PORT=4301
PLAYGROUND_PORT=4302

# WhatsApp number for the contact form, international format without "+", e.g. 6281234567890.
WHATSAPP_NUMBER=

# Receptionist assistant on the local Ollama model (see deploy/macmini/ollama).
AI_PROVIDER=ollama
AI_MODEL=taksu-asisten
AI_BASE_URL=http://127.0.0.1:11434
# Keep the model warm for 30 minutes after a question. Use 24h for events, 5m to save RAM.
AI_KEEP_ALIVE=30m
AI_TIMEOUT_MS=30000
# At most 2 model calls at once; extra visitors get instant offline answers.
AI_MAX_CONCURRENCY=2
# Questions per visitor IP per minute.
ASSISTANT_RATE_LIMIT=12
