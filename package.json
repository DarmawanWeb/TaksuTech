{
  "name": "taksu-tech",
  "private": true,
  "description": "Taksu Tech monorepo: company profile, Bali receptionist kiosk with voice, education simulator, and Docker deployment.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@taksu/web",
    "dev:kiosk": "turbo run dev --filter=@taksu/kiosk",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "prepare": "husky",
    "dev:sim": "turbo run dev --filter=@taksu/sim",
    "test:speech": "cd services/speech && python3 -m pytest -q",
    "deploy": "infra/deploy.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,md,yml,yaml}": "prettier --write"
  }
}
