{
  "name": "education-robot",
  "private": true,
  "description": "Taksu education robots: robot bernama (Ciko, Momo, Garu), toko, simulator blok, dan deploy Docker.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@taksu/web",
    "dev:sim": "turbo run dev --filter=@taksu/sim",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome ci . && turbo run typecheck test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "commitlint": "commitlint",
    "prepare": "husky",
    "deploy": "infra/deploy.sh",
    "biome": "biome"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
